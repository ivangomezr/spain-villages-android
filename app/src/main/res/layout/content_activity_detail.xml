<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#B8E5FA"
    app:layout_behavior="@string/appbar_scrolling_view_behavior">

    <ImageView
        android:id="@+id/ivpueblodetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:scaleType="centerCrop"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:srcCompat="@tools:sample/avatars" />

    <TextView
        android:id="@+id/tvpueblodetail"
        android:layout_width="0dp"
        android:layout_height="33dp"
        android:background="#3E51B5"
        android:gravity="center_horizontal"
        android:text="TextView"
        android:textColor="#B8E5FA"
        android:textSize="23sp"
        app:layout_constraintBottom_toTopOf="@+id/tvprovinciacomunidad"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ivpueblodetail"
        app:layout_constraintVertical_bias="0.0" />

    <TextView
        android:id="@+id/tvprovinciacomunidad"
        android:layout_width="349dp"
        android:layout_height="30dp"
        android:layout_marginTop="48dp"
        android:gravity="center_horizontal"
        android:text="TextView"
        android:textColor="#3E51B5"
        android:textSize="18sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ivpueblodetail" />

    <TextView
        android:id="@+id/tvmasdetail"
        android:layout_width="59dp"
        android:layout_height="21dp"
        android:layout_marginTop="20dp"
        android:gravity="center_horizontal"
        android:onClick="OnClickMas"
        android:text="más..."
        android:textColor="#3E51B5"
        android:textSize="18sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvprovinciacomunidad" />
</androidx.constraintlayout.widget.ConstraintLayout>